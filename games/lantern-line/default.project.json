{
  "name": "LanternLine",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 0,
        "CharacterWalkSpeed": 16,
        "CameraMinZoomDistance": 0.5,
        "CameraMaxZoomDistance": 0.5,
        "CameraMode": "LockFirstPerson",
        "AutoJumpEnabled": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$path": "src/character"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 3
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 0,
        "Brightness": 0,
        "Ambient": [0.02, 0.025, 0.035],
        "OutdoorAmbient": [0.02, 0.025, 0.035],
        "EnvironmentDiffuseScale": 0.2,
        "EnvironmentSpecularScale": 0.3,
        "GlobalShadows": true
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 196.2,
        "StreamingEnabled": false
      }
    },
    "LocalizationService": {
      "GameStrings": {
        "$path": "src/localization/GameStrings.csv"
      }
    }
  }
}
